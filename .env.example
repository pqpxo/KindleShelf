# version 5
TZ=Europe/London
PUID=1000
PGID=1000
WEB_PORT=8112

# Optional. Leave blank and a random key is created and kept in data/secret_key.
# To set your own, generate one with: openssl rand -hex 32
SECRET_KEY=

# Application PIN. Anyone with it can upload and delete books.
# Leave blank only when access is restricted elsewhere (VPN, proxy access list).
APP_PIN=change-me

# Keep false when using both http://SERVER-IP:8112 and the HTTPS domain.
# Set true only when every browser will access KindleShelf through HTTPS.
SESSION_COOKIE_SECURE=false

# IP (or CIDR) of your reverse proxy, comma-separated if more than one.
# Only these may set X-Forwarded-For, so the PIN lockout sees real client IPs.
# Leave blank if you do not use a reverse proxy.
TRUSTED_PROXIES=

CONVERSION_TIMEOUT_SECONDS=300
# Calibre runs at once. Keep at 1 on a Raspberry Pi.
MAX_CONCURRENT_CONVERSIONS=1
MAX_UPLOAD_SIZE_MB=100

SMB_USER=kindle
# Required. Samba will not start without it.
SMB_PASSWORD=
