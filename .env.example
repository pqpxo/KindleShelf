# version 5
TZ=Europe/London
PUID=1000
PGID=1000
WEB_PORT=8112

# Generate with: openssl rand -hex 32
# Recommended. If left blank, a persistent key is created in data/secret_key.
SECRET_KEY=replace-with-a-long-random-value

# Optional application PIN. Leave blank only when access is restricted elsewhere.
APP_PIN=2468

# Keep false when using both http://SERVER-IP:8112 and the HTTPS domain.
# Set true only when every browser will access KindleShelf through HTTPS.
SESSION_COOKIE_SECURE=false

CONVERSION_TIMEOUT_SECONDS=300
MAX_UPLOAD_SIZE_MB=100

SMB_USER=kindle
SMB_PASSWORD=replace-with-a-strong-smb-password
